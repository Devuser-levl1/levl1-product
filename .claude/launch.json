{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "interviewcentral-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/web"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--prefix",
        "apps/web",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}