{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:clear": "node scripts/clear-seed-data.js",
    "seed:demo": "SEED_DEMO=true TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/seed-demo.ts",
    "seed:demo:bootstrap": "SEED_DEMO=true SEED_DEMO_BOOTSTRAP=true TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/seed-demo.ts",
    "seed:demo:reset": "npm run seed:demo",
    "seed:demo:wipe": "SEED_DEMO=true SEED_DEMO_RESET_ONLY=true TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/seed-demo.ts",
    "provision:admin": "ALLOW_ADMIN_PROVISION=true TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/provision-admin.ts",
    "provision:demo": "ALLOW_ADMIN_PROVISION=true PROVISION_DEMO=true TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/provision-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/three": "^0.184.1",
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.3",
    "cashfree-pg": "^6.0.4",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "imapflow": "^1.4.2",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "next": "14.2.35",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^2.4.5",
    "pg-boss": "^12.18.3",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.9.0",
    "shepherd.js": "^15.2.2",
    "three": "^0.184.0",
    "twilio": "^5.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
